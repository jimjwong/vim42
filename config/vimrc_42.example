" ================================
" vim42 Configuration
" ================================

set nocompatible

" 42 Header Identity
" The installer replaces yourLogin and yourLogin@student.42.fr.

let g:user42 = 'yourLogin'
let g:mail42 = 'yourLogin@student.42.fr'

" Some 42 header versions read environment variables instead of g: variables.
" These are Vim-only variables for this Vim session.

let $USER = 'yourLogin'
let $MAIL = 'yourLogin@student.42.fr'

" Load vim42 Header Plugin

if filereadable(expand('~/.vim42/plugin/stdheader.vim'))
	source ~/.vim42/plugin/stdheader.vim
else
	echoerr 'vim42: ~/.vim42/plugin/stdheader.vim not found'
endif

" Norminette-friendly Tab Settings

set noexpandtab
set tabstop=4
set shiftwidth=4
set softtabstop=4

" Show Invisible Characters

set list
set listchars=tab:>-,trail:·

" Useful C Programming Settings

syntax on
set number
set autoindent
set cindent
